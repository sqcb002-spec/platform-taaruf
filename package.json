{
  "name": "platform-taaruf-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:landing": "npm run dev --workspace=@taaruf/landing",
    "dev:dashboard": "npm run dev --workspace=@taaruf/dashboard",
    "dev:api": "npm run dev --workspace=@taaruf/api",
    "build": "npm run build --workspaces --if-present",
    "build:landing": "npm run build --workspace=@taaruf/landing",
    "build:dashboard": "npm run build --workspace=@taaruf/dashboard",
    "build:api": "npm run build --workspace=@taaruf/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmad28/platform-taaruf.git"
  },
  "engines": { "node": ">=22" },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
