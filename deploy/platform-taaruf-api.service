[Unit]
Description=Platform Ta'aruf Express API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/platform-taaruf-v2
Environment=NODE_ENV=production
Environment=PORT=3003
EnvironmentFile=/home/ubuntu/platform-taaruf-v2/.env.api
ExecStart=/usr/bin/npm run start --workspace=@taaruf/api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/platform-taaruf/private

[Install]
WantedBy=multi-user.target
